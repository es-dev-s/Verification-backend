generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStatus {
  DRAFT
  CONFIRMED
}

enum DocumentType {
  CV
  TRANSCRIPT
  CERTIFICATE
}

enum DocumentFormat {
  PDF
  PNG
  JPG
  DOCX
}

enum DocumentStatus {
  QUEUED
  EXTRACTING
  DONE
  FAILED
}

enum ReadSection {
  EDUCATION
  EXPERIENCE
}

enum ReadJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Selected / document-scoped education level. Null on CV documents and experience read jobs.
/// Career episode / project source (Step 1 upload only — not used by any other step yet).
/// Step 6 manual decision. No row = pending (not decided yet).
enum CaseReviewStatus {
  APPROVED
  REJECTED
}

enum ProjectSource {
  WORK_BASED
  ACADEMIC_PERSONAL
  FIRM_PREPARED
}

enum DegreeLevel {
  diploma
  advanced_diploma
  bachelor
  master
  phd
}

model Case {
  id                       String     @id @default(cuid())
  clientId                 String
  targetOccupation         String?
  status                   CaseStatus @default(DRAFT)
  /// User-selected degree levels for this case (ordered preference left to UI).
  selectedDegreeLevels     DegreeLevel[] @default([])
  /// Manual-only: is any verified qualification an engineering-titled degree? Never set by AI.
  engineeringTitledDegree  Boolean?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  documents         Document[]
  readJobs          ReadJob[]
  experienceRows    ExperienceRow[]
  qualifications    Qualification[]
  fieldSources      FieldSource[]
  draftJson         Json?
  assessment        Assessment?
  extractedSubjects ExtractedSubject[]
  careerEpisodes    CareerEpisode[]
  review            CaseReview?

  @@index([clientId])
}

/// Persisted ANZSCO assessment result for a case (currently Chemical Engineer 233111).
model Assessment {
  id                    String   @id @default(cuid())
  caseId                String   @unique
  /// Hash of transcript (+ CV) text used as input — skip re-LLM when unchanged.
  inputHash             String
  anzscoCode            String?
  /// high | medium | low | null when no_match
  confidence            String?
  /// verified_no_risk | conditional | not_verified | no_match
  determination         String
  recommended           Boolean  @default(false)
  foundationalMatched   Int      @default(0)
  foundationalExpected  Int      @default(5)
  coreMatched           Int      @default(0)
  coreExpected          Int      @default(9)
  foundationalPct       Float    @default(0)
  corePct               Float    @default(0)
  tier1Outcome          String?
  tier2Outcome          String?
  tier3GateMet          Boolean  @default(false)
  workExperienceBoost   Boolean  @default(false)
  qualificationsUsed    String[] @default([])
  explanation           String?
  resultJson            Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

/// Subject rows extracted from transcript text (persisted so assessment can rerun without LLM).
model ExtractedSubject {
  id             String  @id @default(cuid())
  caseId         String
  documentId     String?
  name           String
  code           String?
  credits        String?
  grade          String?
  yearOrSemester String?
  /// bachelor | master | unknown
  qualification  String  @default("unknown")
  sourceSnippet  String?
  isRepeat       Boolean @default(false)
  sortOrder      Int     @default(0)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Document {
  id               String         @id @default(cuid())
  caseId           String
  /// Document kind (CV | TRANSCRIPT | CERTIFICATE). Existing column name `type` — same role as "docType" in the multi-degree plan.
  type             DocumentType
  /// Null for CV. Required for TRANSCRIPT / CERTIFICATE once multi-degree uploads are wired.
  degreeLevel      DegreeLevel?
  originalName     String
  format           DocumentFormat
  sha256           String
  status           DocumentStatus @default(QUEUED)
  error            String?
  text             String?
  extractionMethod String?
  ocrConfidence    Float?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  case         Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fieldSources FieldSource[]

  @@unique([caseId, sha256])
  @@index([caseId])
  @@index([caseId, type, degreeLevel])
  @@index([status])
}

model ReadJob {
  id          String        @id
  caseId      String
  section     ReadSection
  /// Set for EDUCATION jobs (one job per degree level). Null for EXPERIENCE.
  degreeLevel DegreeLevel?
  inputHash   String
  status      ReadJobStatus @default(QUEUED)
  resultJson  Json?
  error       String?
  stale       Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, section, degreeLevel])
  @@index([status])
}

model ExperienceRow {
  id                  String   @id @default(cuid())
  caseId              String
  employer            String?
  title               String?
  start               String?
  end                 String?
  domainSuggested     Boolean?
  domainFinal         Boolean?
  sortOrder           Int      @default(0)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

/// One education qualification block per selected degree level on a case.
model Qualification {
  id                 String      @id @default(cuid())
  caseId             String
  degreeLevel        DegreeLevel
  degreeTitle        String?
  institution        String?
  country            String?
  durationYears      Float?
  durationCalculated Boolean     @default(false)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, degreeLevel])
  @@index([caseId])
}

model FieldSource {
  id               String       @id @default(cuid())
  caseId           String
  field            String
  /// Education field sources are scoped per degree level. Null reserved for non-level fields if added later.
  degreeLevel      DegreeLevel?
  sourceDocumentId String?
  extractedValue   String?
  finalValue       String?
  confidence       Float?
  alternatives     Json?

  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceDocument Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@unique([caseId, field, degreeLevel])
  @@index([caseId])
  @@index([caseId, degreeLevel])
}

/// Career episode / project document uploaded in Step 1. Stored only — never OCR'd,
/// parsed, or used by assessment / risk (kept out of `Document` on purpose so no
/// worker or pipeline picks it up).
model CareerEpisode {
  id              String         @id @default(cuid())
  caseId          String
  /// WORK_BASED | ACADEMIC_PERSONAL | FIRM_PREPARED (null until the user picks one).
  projectSource   ProjectSource?
  /// ExperienceRow.id selected at link time. Plain id (no FK) because experience rows
  /// are re-created on draft save / Read; `experienceLabel` keeps the link readable.
  experienceRowId String?
  /// Snapshot of the linked role, e.g. "Site Engineer — ABC Pvt Ltd (Jan 2020 – Present)".
  experienceLabel String?
  originalName    String
  format          DocumentFormat
  sizeBytes       Int
  sha256          String
  /// Original file bytes (max upload size applies).
  fileData        Bytes
  sortOrder       Int            @default(0)
  /// Evidence checkboxes the user ticks manually (stored only; not used by other steps).
  hasCalculations         Boolean @default(false)
  hasDrawingsCad          Boolean @default(false)
  hasDataTables           Boolean @default(false)
  hasSiteProductImages    Boolean @default(false)
  hasStandardsReferenced  Boolean @default(false)
  hasQuantifiableOutcomes Boolean @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

/// Step 6 approve / reject decision for a case (one per case; saving again overwrites).
model CaseReview {
  id         String           @id @default(cuid())
  caseId     String           @unique
  status     CaseReviewStatus
  comment    String?
  /// When the current decision was saved (updated on every change).
  reviewedAt DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}
