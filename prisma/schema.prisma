generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStatus {
  DRAFT
  CONFIRMED
}

enum DocumentType {
  CV
  TRANSCRIPT
  CERTIFICATE
}

enum DocumentFormat {
  PDF
  PNG
  JPG
  DOCX
}

enum DocumentStatus {
  QUEUED
  EXTRACTING
  DONE
  FAILED
}

enum ReadSection {
  EDUCATION
  EXPERIENCE
}

enum ReadJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Case {
  id                String   @id @default(cuid())
  clientId          String
  targetOccupation  String?
  status            CaseStatus @default(DRAFT)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documents     Document[]
  readJobs      ReadJob[]
  experienceRows ExperienceRow[]
  bachelors     Bachelors?
  fieldSources  FieldSource[]
  draftJson     Json?

  @@index([clientId])
}

model Document {
  id                String         @id @default(cuid())
  caseId            String
  type              DocumentType
  originalName      String
  format            DocumentFormat
  sha256            String
  status            DocumentStatus @default(QUEUED)
  error             String?
  text              String?
  extractionMethod  String?
  ocrConfidence     Float?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fieldSources  FieldSource[]

  @@unique([caseId, sha256])
  @@index([caseId])
  @@index([status])
}

model ReadJob {
  id         String        @id
  caseId     String
  section    ReadSection
  inputHash  String
  status     ReadJobStatus @default(QUEUED)
  resultJson Json?
  error      String?
  stale      Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, section])
  @@index([status])
}

model ExperienceRow {
  id                   String  @id @default(cuid())
  caseId               String
  employer             String?
  title                String?
  start                String?
  end                  String?
  statedDurationYears  Float?
  domainSuggested      Boolean?
  domainFinal          Boolean?
  sortOrder            Int     @default(0)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Bachelors {
  caseId             String  @id
  degreeTitle        String?
  institution        String?
  country            String?
  durationYears      Float?
  durationCalculated Boolean @default(false)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model FieldSource {
  id               String  @id @default(cuid())
  caseId           String
  field            String
  sourceDocumentId String?
  extractedValue   String?
  finalValue       String?
  confidence       Float?
  alternatives     Json?

  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceDocument Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@unique([caseId, field])
  @@index([caseId])
}
