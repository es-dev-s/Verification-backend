# Copy to .env and fill in.

PORT=3001
DATABASE_URL=postgresql://user:pass@localhost:5432/verification
REDIS_URL=redis://localhost:6379
EXTRACTOR_URL=http://localhost:5000
MAX_UPLOAD_BYTES=10485760
BLOB_TTL_SECONDS=3600
PARSE_TIMEOUT_MS=10000
PARSE_RPM=60
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-flash-latest
# GEMINI_DEBUG_LOG_PAYLOADS=true
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Subject-list extraction (Groq) — split transcript across all keys in parallel
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# GROQ_MODEL=openai/gpt-oss-120b

# Optional (form autofill still uses Gemini; Mistral not used for subjects)
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
