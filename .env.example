# Copy to .env and fill in.

PORT=3001
DATABASE_URL=postgresql://user:pass@localhost:5432/verification
REDIS_URL=redis://localhost:6379
EXTRACTOR_URL=http://localhost:5000
MAX_UPLOAD_BYTES=10485760
BLOB_TTL_SECONDS=3600
# Full-document extract (PaddleOCR multi-page). Default 15 minutes.
EXTRACT_TIMEOUT_MS=900000
STUCK_EXTRACT_MINUTES=20
PARSE_TIMEOUT_MS=10000
PARSE_RPM=60
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-flash-latest
# GEMINI_DEBUG_LOG_PAYLOADS=true
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Groq — subject extraction + work-experience relevance vs top ANZSCO
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# GROQ_MODEL=openai/gpt-oss-120b
# ASSESS_LLM_EXPERIENCE=true
# Number of academically-ranked occupations judged for work experience before the top-3 cut
# ASSESS_BOOST_SHORTLIST=6
# Ranking coverage = 100 x [(1-W) x matched/total + W x min(1, matched/REF)] per tier (W=0 = plain %)
# ASSESS_COVERAGE_ABS_WEIGHT=0.4
# ASSESS_COVERAGE_CORE_REF=8
# ASSESS_COVERAGE_FOUNDATION_REF=5
